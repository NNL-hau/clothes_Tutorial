<Window x:Class="SlidingLoginDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlidingLoginDemo"
        Title="Login" Width="900" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F3">

    <Window.Resources>

        <!-- Primary rounded button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <!-- XÓA: <Setter Property="Width" Value="190"/> -->
            <Setter Property="Background" Value="#2F9E92"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Social icon button -->
        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#F3F7F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded PasswordBox -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#F3F7F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay outline button -->
        <Style x:Key="OverlayOutlineButton" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoogleSignInButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#DDE6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="23"
                        Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Google icon -->
                                <Border Width="28" Height="28"
                                Background="White"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                    <Image Width="18" Height="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/Assets/google.png"

                                   Stretch="Uniform"/>
                                </Border>

                                <!-- Text (full) -->
                                <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="{TemplateBinding Content}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F9F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CFE0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF4F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Card container -->
        <Border x:Name="Card"
                Width="760" Height="420"
                Background="White"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.25"/>
            </Border.Effect>

            <Grid x:Name="RootGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIGN IN (Left) -->
                <Grid x:Name="SignInPanel"
                      Grid.Column="0"
                      Margin="48,0,48,0"
                      Opacity="1"
                      Visibility="Visible"
                      Panel.ZIndex="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SignInTransform" X="0"/>
                    </Grid.RenderTransform>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sign in Tutorial"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="#2F9E92"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                      
                       

                        <TextBox x:Name="UserSignIn"
                                 Style="{StaticResource RoundedTextBox}"
                                 local:WatermarkService.Watermark="Username"
                                 Margin="0,0,0,12"/>

                        <PasswordBox x:Name="PassIn"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     local:WatermarkService.Watermark="Password"
                                     Margin="0,0,0,24"/>
                        <Button Content="SIGN IN"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="260"
                                    Click="SignIn_Click"
                                    Margin="0,0,0,20"/>

                        <TextBlock Text="or sign in with"
                                   Foreground="#6F7F7F"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <Button Content="Sign in with Google"
                                    Style="{StaticResource GoogleSignInButton}"
                                    Width="260"
                                    Click="GoogleSignIn_Click"
                                    HorizontalAlignment="Center"/>  


                    </StackPanel>
                </Grid>

                <!-- SIGN UP (Right) -->
                <Grid x:Name="SignUpPanel"
                      Grid.Column="1"
                      Margin="48,0,48,0"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      Panel.ZIndex="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SignUpTransform" X="0"/>
                    </Grid.RenderTransform>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Create Account"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="#2F9E92"
                                   HorizontalAlignment="Center"/>

                        

                        <TextBlock Text="or use your username for registration:"
                                   Foreground="#9AA8A8"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <TextBox x:Name="NameUp"
                                 Style="{StaticResource RoundedTextBox}"
                                 local:WatermarkService.Watermark="Username"
                                 Margin="0,0,0,12"/>

                        <TextBox x:Name="AddressUp"
                                  Style="{StaticResource RoundedTextBox}"
                                  local:WatermarkService.Watermark="Address (Optional)"
                                  Margin="0,0,0,8"/>

                        <TextBox x:Name="PhoneUp"
                                  Style="{StaticResource RoundedTextBox}"
                                  local:WatermarkService.Watermark="Phone (Optional)"
                                  Margin="0,0,0,8"/>

                        <PasswordBox x:Name="PassUp"
                                      Style="{StaticResource RoundedPasswordBox}"
                                      local:WatermarkService.Watermark="Password"
                                      Margin="0,0,0,14"/>

                        <Button Content="SIGN UP"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="260"
                                    Click="SignUp_Click"/>
                    </StackPanel>
                </Grid>

                <!-- OVERLAY (Green panel slides) -->
                <Border x:Name="Overlay"
                        Grid.ColumnSpan="2"
                        CornerRadius="16"
                        Background="#2F9E92"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="10">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="OverlayTransform" X="0"/>
                    </Border.RenderTransform>

                    <!-- Center text correctly -->
                    <Grid Margin="28">
                        <!-- Welcome Back -->
                        <StackPanel x:Name="OverlayLeftText"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0"
                                     IsHitTestVisible="False">
                             <TextBlock Text="Welcome Back!"
                                        Foreground="White"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"/>
                            <TextBlock Text="To keep connected with us&#x0a;please login with your personal info"
                                        Foreground="White"
                                        Opacity="0.9"
                                        FontSize="14"
                                        LineHeight="20"
                                        TextAlignment="Center"
                                        Margin="0,10,0,20"/>
                            <Button x:Name="GoSignInBtn"
                                    Content="SIGN IN"
                                    Style="{StaticResource OverlayOutlineButton}"/>
                        </StackPanel>

                        <!-- Hello Friend -->
                        <StackPanel x:Name="OverlayRightText"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="1"
                                    IsHitTestVisible="True">
                             <TextBlock Text="Hello, Friend!"
                                        Foreground="White"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"/>
                            <TextBlock Text="Enter your personal details&#x0a;and start journey with us"
                                        Foreground="White"
                                        Opacity="0.9"
                                        FontSize="14"
                                        LineHeight="20"
                                        TextAlignment="Center"
                                        Margin="0,10,0,20"/>
                            <Button x:Name="GoSignUpBtn"
                                    Content="ĐĂNG NHẬP"
                                    Style="{StaticResource OverlayOutlineButton}"/>
                        </StackPanel>
                        
                        <!-- Snow Canvas (On top) -->
                        <Canvas x:Name="SnowField" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
