    private void UpdateAddressCascading()
    {
        if (vietnamData == null) return;

        // Try exact match or normalized match
        var province = vietnamData.FirstOrDefault(p => p.Name == checkoutForm.Province || 
                                                       p.Name == "Thành phố " + checkoutForm.Province || 
                                                       p.Name == "Tỉnh " + checkoutForm.Province);
        if (province != null)
        {
            checkoutForm.Province = province.Name; // Normalize
            currentDistricts = province.Districts;
            
            var district = currentDistricts.FirstOrDefault(d => d.Name == checkoutForm.District ||
                                                                d.Name == "Quận " + checkoutForm.District ||
                                                                d.Name == "Huyện " + checkoutForm.District ||
                                                                d.Name == "Thành phố " + checkoutForm.District);
            if (district != null)
            {
                checkoutForm.District = district.Name; // Normalize
                currentWards = district.Wards;
                
                var ward = currentWards.FirstOrDefault(w => w.Name == checkoutForm.Ward ||
                                                            w.Name == "Phường " + checkoutForm.Ward ||
                                                            w.Name == "Xã " + checkoutForm.Ward ||
                                                            w.Name == "Thị trấn " + checkoutForm.Ward);
                if (ward != null)
                {
                    checkoutForm.Ward = ward.Name; // Normalize
                }
            }
            else
            {
                currentWards = new List<Ward>();
            }
        }
        else
        {
            currentDistricts = new List<District>();
            currentWards = new List<Ward>();
        }
    }

