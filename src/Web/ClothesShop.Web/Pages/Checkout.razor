    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        // Initialize address service to load JSON data
        await AddressService.InitializeAsync();
        provinces = AddressService.GetProvinces();

        basket = await BasketService.GetBasketAsync();
        if (basket != null)
        {
            // Only keep selected items for checkout
            basket.Items = basket.Items.Where(i => i.IsSelected).ToList();
        }
        
        var user = AuthService.CurrentUser;
        if (user != null)
        {
            checkoutForm.FullName = user.FullName;
            checkoutForm.Email = user.Email;
            checkoutForm.PhoneNumber = user.PhoneNumber ?? "";
            
            // Try to parse existing address
            if (!string.IsNullOrEmpty(user.Address))
            {
                var parts = user.Address.Split(", ").Select(p => p.Trim()).ToList();
                if (parts.Count >= 4)
                {
                    checkoutForm.AddressDetail = parts[0];
                    checkoutForm.Ward = parts[1];
                    checkoutForm.District = parts[2];
                    checkoutForm.Province = parts[3];
                    
                    districts = AddressService.GetDistricts(checkoutForm.Province);
                    wards = AddressService.GetWards(checkoutForm.District);
                }
                else
                {
                    checkoutForm.AddressDetail = user.Address;
                }
            }
        }

        isLoading = false;
        editContext?.NotifyValidationStateChanged();
    }

