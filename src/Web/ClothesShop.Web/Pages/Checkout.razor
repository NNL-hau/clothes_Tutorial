            if (selectedMethod == "MoMo")
            {
                // Redirect đến trang MoMo demo nội bộ
                // payUrl và qrCodeUrl thực từ MoMo sandbox để quét QR thật
                var encodedPayUrl    = Uri.EscapeDataString(transaction.PaymentUrl ?? "");
                var encodedQrCodeUrl = Uri.EscapeDataString(transaction.QrCodeUrl  ?? "");
                var momoPageUrl = $"/momo-payment?orderId={createdOrder.Id}&transactionId={transaction.Id}&amount={basket.TotalPrice}&payUrl={encodedPayUrl}&qrCodeUrl={encodedQrCodeUrl}";
                Console.WriteLine($"[Checkout] Redirecting to MoMo page. PayUrl: {transaction.PaymentUrl}, QrCodeUrl: {transaction.QrCodeUrl}");
                Navigation.NavigateTo(momoPageUrl, forceLoad: true);
                return;
            }
            
            // COD và phương thức khác: trừ kho trước khi xóa giỏ
            var basketSnapshot = await BasketService.GetBasketAsync();
            if (basketSnapshot != null)
            {
                basketSnapshot.Items = basketSnapshot.Items.Where(i => i.IsSelected).ToList();
            }
            await BasketService.RemoveSelectedItemsAsync();
            await DeductStockFromBasketItems(basketSnapshot);
            await EmailService.SendOrderConfirmationEmailAsync(checkoutForm.Email, checkoutForm.FullName, createdOrder.Id.ToString(), basketSnapshot?.TotalPrice ?? 0);

            Console.WriteLine("[Checkout] Redirecting to success page.");
            Navigation.NavigateTo($"/success/{createdOrder.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi hệ thống: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DeductStockFromBasketItems(CustomerBasket? snapshot = null)
    {
        var target = snapshot ?? basket;
        if (target == null || !target.Items.Any())
        {
            Console.WriteLine("[Checkout] No basket items to deduct stock from.");
            return;
        }

        Console.WriteLine($"[Checkout] Deducting stock for {target.Items.Count} item(s).");
        stockDeductionFailed = false;
        failedStockItems.Clear();

        foreach (var item in target.Items)
        {
            try
            {
                Console.WriteLine($"[Checkout] Calling DeductStockAsync for {item.ProductName} x{item.Quantity}...");
                var success = await ProductService.DeductStockAsync(item.ProductId, item.Quantity);
                if (!success)
                {
                    Console.WriteLine($"[Checkout] API rejected stock deduction for {item.ProductName}.");
                    stockDeductionFailed = true;
                    failedStockItems.Add(item.ProductName);
                }
                else
                {
                    Console.WriteLine($"[Checkout] Stock deducted OK for {item.ProductName}.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Checkout] Error deducting stock for {item.ProductName}: {ex.Message}");
                stockDeductionFailed = true;
                failedStockItems.Add(item.ProductName);
            }
        }

        if (stockDeductionFailed)
        {
            errorMessage = $"Lỗi cập nhật tồn kho: {string.Join(", ", failedStockItems)}. Đơn hàng vẫn được ghi nhận.";
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();
        
        if (string.IsNullOrWhiteSpace(checkoutForm.FullName))
            validationErrors["FullName"] = "Vui lòng nhập họ và tên.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.PhoneNumber))
            validationErrors["PhoneNumber"] = "Vui lòng nhập số điện thoại.";
        else if (!Regex.IsMatch(checkoutForm.PhoneNumber, @"^0\d{9}$"))
            validationErrors["PhoneNumber"] = "Số điện thoại phải có 10 chữ số và bắt đầu bằng số 0.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.Email))
            validationErrors["Email"] = "Vui lòng nhập email.";
        else if (!Regex.IsMatch(checkoutForm.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            validationErrors["Email"] = "Email không đúng định dạng.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.Province))
            validationErrors["Province"] = "Vui lòng chọn tỉnh/thành phố.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.District))
            validationErrors["District"] = "Vui lòng chọn quận/huyện.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.Ward))
            validationErrors["Ward"] = "Vui lòng chọn phường/xã.";
            
        if (string.IsNullOrWhiteSpace(checkoutForm.AddressDetail))
            validationErrors["AddressDetail"] = "Vui lòng nhập địa chỉ chi tiết.";
            
        return validationErrors.Count == 0;
    }

