@page "/admin"
@layout AdminLayout
@inherits AuthorizedPageBase
@inject IProductApiService ProductService
@inject IOrderApiService OrderService
@inject IUserApiService UserService
@inject IReviewApiService ReviewService
@using ClothesShop.Web.Models

<div class="dashboard">
    <div style="margin-bottom: 2rem;">
        <h2 style="font-weight: 800; color: #0f172a; font-size: 1.8rem; margin: 0;">Bàn làm việc</h2>
        <p style="color: #64748b; font-size: 1rem; margin-top: 0.3rem;">Chào mừng quay trở lại. Đây là tình hình cửa hàng của bạn hôm nay.</p>
    </div>

    @if (isLoading)
    {
        <div class="glass-card p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Đang tổng hợp dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var stat in QuickStats)
            {
                <div class="col-md-3">
                    <div class="premium-card @stat.Class">
                        <div class="stat-icon-wrapper">
                            <i class="@stat.Icon"></i>
                        </div>
                        <div>
                            <div class="stat-label">@stat.Label</div>
                            <div class="stat-value">@stat.Value</div>
                            <div class="stat-trend @(stat.IsPositive ? "trend-up" : "trend-down")">
                                <i class="fa-solid @(stat.IsPositive ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
                                @stat.Trend
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="premium-card h-100 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 style="font-weight: 700; color: #1e293b;">Doanh thu 12 tháng gần nhất (Tr.VNĐ)</h5>
                        <div class="status-indicator">
                            <span class="pulse-dot"></span>
                            Cập nhật mới nhất
                        </div>
                    </div>
                    <div style="height: 300px; display: flex; align-items: flex-end; gap: 12px; padding: 10px 0;">
                        @foreach (var val in MonthlyRevenue)
                        {
                            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                                <div class="realtime-bar" style="height: @(val * 1.5)px; width: 100%; background: linear-gradient(180deg, #1a73e8 0%, #64b5f6 100%);" title="@($"{val} Tr.VNĐ")"></div>
                                <span style="font-size: 0.75rem; color: #94a3b8;">T@(MonthlyRevenue.IndexOf(val) + 1)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="premium-card h-100 p-4">
                    <h5 style="font-weight: 700; color: #1e293b; margin-bottom: 1.5rem;">Cập nhật hệ thống</h5>
                    <div class="notification-list">
                        @if (!LiveNotifications.Any())
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fa-solid fa-bell-slash d-block mb-2" style="font-size: 2rem;"></i>
                                Không có thông báo mới
                            </div>
                        }
                        @foreach (var note in LiveNotifications)
                        {
                            <div class="live-item">
                                <div class="live-icon @note.Type">
                                    <i class="@note.Icon"></i>
                                </div>
                                <div class="live-body">
                                    <div class="live-title">@note.Title</div>
                                    <div class="live-time">@note.Description</div>
                                </div>
                            </div>
                        }
                    </div>
                    <NavLink href="/admin/orders" class="btn btn-light w-100 mt-4" style="font-weight: 600; border-radius: 10px;">Xem đơn hàng</NavLink>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .premium-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px rgba(15, 23, 42, 0.02);
        display: flex;
        gap: 1.2rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .premium-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px rgba(15, 23, 42, 0.04);
    }

    .stat-icon-wrapper {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: #f1f5f9;
        color: #1a73e8;
    }

    .stat-label { font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.2rem; }
    .stat-value { font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 0.1rem; }
    
    .trend-up { color: #10b981; font-size: 0.8rem; font-weight: 700; }
    .trend-down { color: #ef4444; font-size: 0.8rem; font-weight: 700; }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #10b981;
        font-weight: 600;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .realtime-bar {
        border-radius: 8px 8px 3px 3px;
        transition: height 0.5s ease-in-out;
    }

    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .live-item {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .live-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .live-icon.order { background: #ecfdf5; color: #10b981; }
    .live-icon.review { background: #eff6ff; color: #1a73e8; }
    .live-icon.warn { background: #fffbeb; color: #f59e0b; }

    .live-title { font-size: 0.85rem; font-weight: 600; color: #1e293b; }
    .live-time { font-size: 0.75rem; color: #94a3b8; }
</style>

@code {
    private bool isLoading = true;
    private List<Stat> QuickStats = new();
    private List<int> MonthlyRevenue = new();
    private List<DashboardNote> LiveNotifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        try
        {
            var productsTask = ProductService.GetProductsAsync();
            var ordersTask = OrderService.GetOrdersAsync();
            var usersTask = UserService.GetUsersAsync();
            var reviewsTask = ReviewService.GetReviewsAsync();

            await Task.WhenAll(productsTask, ordersTask, usersTask, reviewsTask);

            var products = await productsTask;
            var orders = await ordersTask;
            var users = await usersTask;
            var reviews = await reviewsTask;

            // 1. Calculate Quick Stats
            var today = DateTime.Today;
            var todayOrders = orders.Where(o => o.CreatedAt.Date == today).ToList();
            var todayRevenue = todayOrders.Sum(o => o.TotalPrice);
            
            QuickStats = new()
            {
                new("Sản phẩm", products.Count.ToString("N0"), "Cập nhật", true, "fa-solid fa-cube", ""),
                new("Đơn hôm nay", todayOrders.Count.ToString(), todayOrders.Count > 0 ? "Bắt đầu" : "0", true, "fa-solid fa-cart-shopping", ""),
                new("Doanh thu hôm nay", todayRevenue.ToString("N0") + "₫", "Hôm nay", true, "fa-solid fa-money-bill-trend-up", ""),
                new("Khách hàng", users.Count.ToString("N0"), "Người dùng", true, "fa-solid fa-user-tag", "")
            };

            // 2. Prepare Chart Data (Simulated monthly aggregate for chart demo, as current DB only has recent data)
            // In a real production app, the Backend would return Monthly Sales data.
            // Here we aggregate based on the orders we have.
            MonthlyRevenue = new List<int>();
            for (int i = 1; i <= 12; i++)
            {
                var monthOrders = orders.Where(o => o.CreatedAt.Month == i && o.CreatedAt.Year == today.Year);
                var revenue = monthOrders.Sum(o => o.TotalPrice) / 1000000; // In millions
                MonthlyRevenue.Add((int)Math.Max(5, revenue)); // Fallback to 5 for UI visibility
            }

            // 3. Prepare Live Notifications
            LiveNotifications = new();
            
            // New orders
            foreach (var order in orders.OrderByDescending(o => o.CreatedAt).Take(2))
            {
                LiveNotifications.Add(new($"Đơn hàng mới #{order.Id.ToString().Substring(0, 4)}", $"{order.UserName} - {order.CreatedAt:HH:mm}", "order", "fa-solid fa-shopping-bag"));
            }

            // Low stock
            var lowStock = products.Where(p => p.StockQuantity > 0 && p.StockQuantity <= 5).Take(1).FirstOrDefault();
            if (lowStock != null)
            {
                LiveNotifications.Add(new($"Hàng sắp hết: {lowStock.Name}", $"Cần nhập thêm - Tồn: {lowStock.StockQuantity}", "warn", "fa-solid fa-triangle-exclamation"));
            }

            // New reviews
            var pendingReview = reviews.Where(r => !r.IsApproved).OrderByDescending(r => r.CreatedAt).Take(1).FirstOrDefault();
            if (pendingReview != null)
            {
                LiveNotifications.Add(new($"Bình luận mới: {pendingReview.UserName}", "Chờ duyệt", "review", "fa-solid fa-comment-dots"));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public record Stat(string Label, string Value, string Trend, bool IsPositive, string Icon, string Class);
    public record DashboardNote(string Title, string Description, string Type, string Icon);

    protected override bool RequireAdminRole => true;
}

