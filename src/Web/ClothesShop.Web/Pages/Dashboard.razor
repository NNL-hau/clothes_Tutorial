@page "/admin"
@layout AdminLayout

<div class="dashboard">
    <div style="margin-bottom: 2rem;">
        <h2 style="font-weight: 800; color: #0f172a; font-size: 1.8rem; margin-bottom: 0.3rem;">Bàn làm việc</h2>
        <p style="color: #64748b; font-size: 1rem;">Theo dõi nhanh các chỉ số quan trọng của cửa hàng hôm nay.</p>
    </div>

    <div class="row g-4 mb-4">
        @foreach (var stat in QuickStats)
        {
            <div class="col-md-3">
                <div class="premium-card @stat.Class">
                    <div class="stat-icon-wrapper">
                        <i class="@stat.Icon"></i>
                    </div>
                    <div>
                        <div class="stat-label">@stat.Label</div>
                        <div class="stat-value">@stat.Value</div>
                        <div class="stat-trend @(stat.IsPositive ? "trend-up" : "trend-down")">
                            <i class="fa-solid @(stat.IsPositive ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
                            @stat.Trend
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="premium-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 style="font-weight: 700; color: #1e293b;">Biểu đồ Doanh thu (Real-time)</h5>
                    <div class="status-indicator">
                        <span class="pulse-dot"></span>
                        Đang nhận dữ liệu...
                    </div>
                </div>
                <div style="height: 300px; display: flex; align-items: flex-end; gap: 12px; padding: 10px 0;">
                    @foreach (var val in MonthlyRevenue)
                    {
                        <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                            <div class="realtime-bar" style="height: @(val * 2.5)px; width: 100%; background: linear-gradient(180deg, #1a73e8 0%, #64b5f6 100%);"></div>
                            <span style="font-size: 0.75rem; color: #94a3b8;">T@(MonthlyRevenue.IndexOf(val) + 1)</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card h-100 p-4">
                <h5 style="font-weight: 700; color: #1e293b; margin-bottom: 1.5rem;">Thông báo Trực tiếp</h5>
                <div class="notification-list">
                    @foreach (var note in LiveNotifications)
                    {
                        <div class="live-item">
                            <div class="live-icon @note.Type">
                                <i class="@note.Icon"></i>
                            </div>
                            <div class="live-body">
                                <div class="live-title">@note.Title</div>
                                <div class="live-time">@note.Time</div>
                            </div>
                        </div>
                    }
                </div>
                <button class="btn w-100 mt-4" style="background: #f1f5f9; color: #64748b; font-weight: 600; border-radius: 10px;">Xem tất cả</button>
            </div>
        </div>
    </div>
</div>

<style>
    .premium-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px rgba(15, 23, 42, 0.02);
        display: flex;
        gap: 1.2rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .premium-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px rgba(15, 23, 42, 0.04);
    }

    .stat-icon-wrapper {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: #f8fafc;
        color: #1a73e8;
    }

    .stat-label { font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.2rem; }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 0.1rem; }
    
    .trend-up { color: #10b981; font-size: 0.8rem; font-weight: 700; }
    .trend-down { color: #ef4444; font-size: 0.8rem; font-weight: 700; }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #10b981;
        font-weight: 600;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .realtime-bar {
        border-radius: 8px 8px 3px 3px;
        transition: height 0.5s ease-in-out;
    }

    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .live-item {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .live-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .live-icon.order { background: #ecfdf5; color: #10b981; }
    .live-icon.review { background: #eff6ff; color: #1a73e8; }
    .live-icon.warn { background: #fffbeb; color: #f59e0b; }

    .live-title { font-size: 0.9rem; font-weight: 600; color: #1e293b; }
    .live-time { font-size: 0.75rem; color: #94a3b8; }
</style>

@code {
    private List<Stat> QuickStats = new()
    {
        new("Sản phẩm", "1,280", "12%", true, "fa-solid fa-cube", ""),
        new("Đơn hôm nay", "24", "8%", true, "fa-solid fa-cart-shopping", ""),
        new("Doanh thu", "45M", "15%", true, "fa-solid fa-money-bill-trend-up", ""),
        new("Khách hàng", "856", "3%", false, "fa-solid fa-user-tag", "")
    };

    private List<int> MonthlyRevenue = new() { 45, 62, 55, 80, 95, 70, 110, 85, 100, 120, 105, 130 };

    private List<Notification> LiveNotifications = new()
    {
        new("Đơn hàng mới #8423", "Vừa mới xong", "order", "fa-solid fa-shopping-bag"),
        new("Bình luận mới sản phẩm Áo Sơ mi", "2 phút trước", "review", "fa-solid fa-comment-dots"),
        new("Sản phẩm Quần Jean sắp hết hàng", "15 phút trước", "warn", "fa-solid fa-triangle-exclamation"),
        new("Thanh toán thành công đơn #8420", "45 phút trước", "order", "fa-solid fa-check-circle")
    };

    public record Stat(string Label, string Value, string Trend, bool IsPositive, string Icon, string Class);
    public record Notification(string Title, string Time, string Type, string Icon);
}
