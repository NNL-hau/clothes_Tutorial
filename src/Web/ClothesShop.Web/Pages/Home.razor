@page "/"

<PageTitle>Trang Chủ - Shop Quần Áo</PageTitle>

<div class="home-page">
    <BannerCarousel />
    
    <!-- Why Choose Us / Features -->
    <section class="features-section">
        <div class="container">
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Miễn phí vận chuyển</h4>
                        <p>Cho đơn hàng từ 500k</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-rotate-left"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Đổi trả dễ dàng</h4>
                        <p>Trong vòng 30 ngày</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-shield-check"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Chất lượng đảm bảo</h4>
                        <p>Hàng chính hãng 100%</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Hỗ trợ 24/7</h4>
                        <p>Tận tâm & Chu đáo</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Spotlight -->
    <section class="category-spotlight">
        <div class="container">
            <div class="section-title">
                <h2>DANH MỤC NỔI BẬT</h2>
                <div class="title-underline"></div>
            </div>
            <div class="spotlight-grid">
                <a href="/products?category=nam" class="spotlight-item male">
                    <div class="spotlight-content">
                        <h3>THỜI TRANG NAM</h3>
                        <span class="btn-discover">Khám phá ngay</span>
                    </div>
                </a>
                <a href="/products?category=nữ" class="spotlight-item female">
                    <div class="spotlight-content">
                        <h3>THỜI TRANG NỮ</h3>
                        <span class="btn-discover">Khám phá ngay</span>
                    </div>
                </a>
                <a href="/products?category=đồng phục" class="spotlight-item accessory">
                    <div class="spotlight-content">
                        <h3>ĐỒNG PHỤC</h3>
                        <span class="btn-discover">Khám phá ngay</span>
                    </div>
                </a>
            </div>
        </div>
    </section>
    
    <!-- Main Product List -->
    <section class="products-section">
        <div class="container">
            <ProductList Title="SẢN PHẨM MỚI NHẤT" InitialCount="12" />
        </div>
    </section>
</div>

<style>
    .home-page {
        background: #f8f9fa;
    }
    
    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Features Section */
    .features-section {
        padding: 40px 0;
        background: white;
        border-bottom: 1px solid #eee;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .feature-icon {
        width: 50px;
        height: 50px;
        background: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #2F4858;
        flex-shrink: 0;
    }

    .feature-text h4 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #333;
    }

    .feature-text p {
        margin: 5px 0 0;
        font-size: 13px;
        color: #777;
    }

    /* Category Spotlight */
    .category-spotlight {
        padding: 80px 0;
    }

    .section-title {
        text-align: center;
        margin-bottom: 50px;
    }

    .section-title h2 {
        font-size: 32px;
        font-weight: 800;
        color: #2F4858;
        letter-spacing: 1px;
        margin-bottom: 15px;
    }

    .title-underline {
        width: 80px;
        height: 4px;
        background: #ffcc00;
        margin: 0 auto;
    }

    .spotlight-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        grid-template-rows: 300px 300px;
        gap: 20px;
    }

    .spotlight-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: flex-end;
        padding: 40px;
        background-size: cover;
        background-position: center;
        transition: all 0.5s ease;
    }

    .spotlight-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.7));
        transition: opacity 0.3s;
    }

    .spotlight-item:hover {
        transform: scale(1.02);
    }

    .spotlight-item:hover::before {
        background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.85));
    }

    .spotlight-item.male {
        grid-row: span 2;
        background-image: url('https://images.unsplash.com/photo-1490578474895-699cd4e2cf59?auto=format&fit=crop&q=80&w=1000');
    }

    .spotlight-item.female {
        background-image: url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&q=80&w=1000');
    }

    .spotlight-item.accessory {
        background-image: url('https://images.unsplash.com/photo-1523381235312-071e274b914d?auto=format&fit=crop&q=80&w=1000');
    }

    .spotlight-content {
        position: relative;
        z-index: 2;
        color: white;
    }

    .spotlight-content h3 {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 15px;
        letter-spacing: 1px;
    }

    .btn-discover {
        display: inline-block;
        padding: 10px 25px;
        background: white;
        color: #2F4858;
        border-radius: 25px;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        transition: all 0.3s;
    }

    .spotlight-item:hover .btn-discover {
        background: #ffcc00;
        color: #2F4858;
    }

    /* Product Section */
    .products-section {
        padding-bottom: 80px;
    }

    @@media (max-width: 992px) {
        .features-grid {
            grid-template-columns: 1fr 1fr;
        }
        
        .spotlight-grid {
            grid-template-columns: 1fr;
            grid-template-rows: repeat(3, 300px);
        }
        
        .spotlight-item.male {
            grid-row: span 1;
        }
    }

    @@media (max-width: 576px) {
        .features-grid {
            grid-template-columns: 1fr;
        }
        
        .section-title h2 {
            font-size: 24px;
        }
    }
</style>

