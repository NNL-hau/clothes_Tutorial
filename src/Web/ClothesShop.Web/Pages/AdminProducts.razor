@page "/admin/products"
@layout AdminLayout

<div class="admin-products">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 800; color: var(--text-main); font-size: 2rem; margin: 0;">Quản lý Sản phẩm</h2>
            <p style="color: var(--text-muted); margin: 0;">Danh sách toàn bộ sản phẩm trong hệ thống</p>
        </div>
        <button class="btn btn-primary-fashion">
            <i class="fa-solid fa-plus me-2"></i> Thêm sản phẩm mới
        </button>
    </div>

    <div class="glass-card p-4">
        <div class="d-flex gap-3 mb-4">
            <div class="search-box-premium">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                <input type="text" placeholder="Tìm tên sản phẩm, mã SKU..." />
            </div>
            <select class="form-select-premium" style="width: 220px;">
                <option selected>Tất cả danh mục</option>
                <option>Áo sơ mi</option>
                <option>Quần Jean</option>
                <option>Váy & Đầm</option>
            </select>
            <button class="btn btn-light-premium">
                <i class="fa-solid fa-filter me-2"></i> Lọc
            </button>
        </div>

        <div class="table-container">
            <table class="table-fashion">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Products)
                    {
                        <tr>
                            <td>
                                <div class="product-info-cell">
                                    <div class="product-img-box">
                                        <img src="@p.ImageUrl" />
                                    </div>
                                    <div>
                                        <div class="product-name">@p.Name</div>
                                        <div class="product-sku">SKU: CLO-@(p.Id.GetHashCode().ToString("X").Substring(0,5))</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="category-badge">@p.Category</span></td>
                            <td class="price-cell">@p.Price.ToString("N0") ₫</td>
                            <td>
                                <div class="stock-info">
                                    <strong>@p.Stock</strong>
                                    <div class="progress mt-1" style="height: 4px; width: 60px;">
                                        <div class="progress-bar bg-primary" style="width: @(Math.Min(p.Stock, 100))%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @(p.Stock > 10 ? "status-success" : "status-warning")">
                                    <i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i>
                                    @(p.Stock > 10 ? "Đang bán" : "Sắp hết hàng")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-action edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn-action delete"><i class="fa-solid fa-trash-can"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-primary-fashion {
        background: var(--primary-color);
        color: white;
        border-radius: 14px;
        padding: 0.8rem 1.8rem;
        font-weight: 600;
        border: none;
        box-shadow: 0 4px 15px rgba(107, 70, 193, 0.3);
        transition: var(--transition);
    }
    
    .btn-primary-fashion:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(107, 70, 193, 0.4);
        background: #5b39a8;
    }

    .search-box-premium {
        background: #f1f3f9;
        border-radius: 14px;
        padding: 0.8rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .search-box-premium input {
        border: none;
        outline: none;
        background: transparent;
        width: 100%;
    }

    .form-select-premium {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.8rem 1.2rem;
        background-color: white;
        color: var(--text-main);
        font-weight: 500;
    }

    .btn-light-premium {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        color: var(--text-main);
    }

    .table-fashion {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.8rem;
    }

    .table-fashion th {
        padding: 1rem 1.5rem;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.9rem;
        border: none;
    }

    .table-fashion tr {
        background: white;
        transition: var(--transition);
    }

    .table-fashion tbody tr:hover {
        transform: scale(1.005);
        box-shadow: 0 5px 15px rgba(0,0,0,0.03);
    }

    .table-fashion td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        border-top: 1px solid #f8f9fa;
        border-bottom: 1px solid #f8f9fa;
    }

    .table-fashion td:first-child {
        border-left: 1px solid #f8f9fa;
        border-radius: 16px 0 0 16px;
    }

    .table-fashion td:last-child {
        border-right: 1px solid #f8f9fa;
        border-radius: 0 16px 16px 0;
    }

    .product-info-cell {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .product-img-box {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: #f1f3f9;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .product-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-name {
        font-weight: 700;
        color: var(--text-main);
        font-size: 1.05rem;
    }

    .product-sku {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .category-badge {
        background: var(--primary-light);
        color: var(--primary-color);
        padding: 0.4rem 1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .price-cell {
        font-weight: 700;
        color: var(--text-main);
    }

    .status-badge {
        padding: 0.4rem 1rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
    }

    .status-success {
        background: #ecfdf5;
        color: #059669;
    }

    .status-warning {
        background: #fffbeb;
        color: #d97706;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 0.8rem;
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        font-size: 1.1rem;
    }

    .btn-action.edit { background: #f0f4ff; color: #4338ca; }
    .btn-action.delete { background: #fff1f2; color: #e11d48; }

    .btn-action:hover {
        transform: translateY(-3px);
        filter: brightness(0.95);
    }
</style>

@code {
    private List<ProductItem> Products = new()
    {
        new(Guid.NewGuid(), "Áo Sơ Mi Lụa Cao Cấp", "Áo sơ mi", 450000, 45, "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=200&h=200&fit=crop"),
        new(Guid.NewGuid(), "Quần Jean Slim Fit", "Quần Jean", 680000, 12, "https://images.unsplash.com/photo-1542272454315-4c01d7abdf4a?w=200&h=200&fit=crop"),
        new(Guid.NewGuid(), "Váy Hoa Nhí Mùa Hè", "Váy & Đầm", 520000, 5, "https://images.unsplash.com/photo-1539008835279-434674508233?w=200&h=200&fit=crop"),
        new(Guid.NewGuid(), "Áo Blazer Hiện Đại", "Áo khoác", 1200000, 20, "https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=200&h=200&fit=crop")
    };

    public record ProductItem(Guid Id, string Name, string Category, decimal Price, int Stock, string ImageUrl);
}
